{
  "name": "robot-dance-animation-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "esbuild src/main.ts --bundle --minify --outfile=dist/bundle.js --out-extension:.js=.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/core.test.ts --bundle --platform=node --format=esm --outfile=dist-tests/test.js && node --test dist-tests/",
    "e2e": "node scripts/e2e-verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}

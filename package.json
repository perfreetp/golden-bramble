{
  "name": "bottle-label-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:geom": "node --experimental-strip-types scripts/geom-smoke.ts",
    "test:reactive": "node --experimental-strip-types --conditions=browser scripts/reactive-smoke.ts",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test": "npm run test:geom && npm run test:reactive"
  },
  "dependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
